{
  "python": "/shared/simpler/.venv/bin/python",
  "mpi": {
    "implementation": "mpich",
    "launcher": "/opt/mpi/bin/mpirun"
  },
  "mpi_transport_library": "/shared/simpler/build/mpi_l3_transport/libsimpler_mpi_l3_transport.so",
  "platform": "a2a3",
  "runtime": "tensormap_and_ringbuffer",
  "block_dim": 1,
  "timeout_s": 300,
  "work_dir": "/tmp",
  "topology_id": "two-machine-master-real-npu-phase1",
  "hosts": [
    {
      "rank": 0,
      "worker_id": 0,
      "local": true,
      "mpi_host": "master-host",
      "device_ids": [0, 1]
    },
    {
      "rank": 1,
      "worker_id": 1,
      "mpi_host": "npu-peer-host",
      "device_ids": [0, 1]
    }
  ]
}
